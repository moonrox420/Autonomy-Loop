# Rename this file to .env and populate the values to configure your Autonomy Loop.

# Stripe API secret key used to create products and checkout sessions.
#STRIPE_API_KEY=

# Currency for prices (e.g. usd, eur)
CURRENCY=usd

# Ports used by the development servers
FRONTEND_PORT=5174
BACKEND_PORT=9333

# Base URL for the frontend when constructing success/cancel URLs for checkout.
FRONTEND_BASE_URL=http://localhost:5174